{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionState",
  "type": "object",
  "properties": {
    "workflowId": {"type":"string"},
    "status": {
      "type":"string",
      "enum":["pending","running","completed","failed"]
    },
    "steps": {
      "type":"array",
      "items": {
        "type":"object",
        "properties": {
          "module": {"type":"string"},
          "action": {"type":"string"},
          "status": {"type":"string"},
          "output": {}
        }
      }
    }
  }
}
